+// ─── AuditLog retention (SF-57) ──────────────────────────────────────────────
+
+/**
+ * Calls audit_log_purge(AUDIT_PURGE_BATCH) until a short batch or the deadline. When the function is absent
+ * (append-only migration not applied yet) it falls back to the direct chunked delete, which the runtime role can
+ * still perform until that migration revokes DELETE. The result names the path taken.
+ */
+async function purgeAuditLog(
+  now: Date,
+  elapsed: () => number,
+): Promise<{ deleted: number; partial?: true; processed?: number; details: Record<string, unknown> }> {
+  let deleted = 0;
+  for (;;) {
+    if (elapsed() > DEADLINE_MS) return { deleted, partial: true, processed: deleted, details: { via: "audit_log_purge" } };
+    const n = await purgeAuditLogBatch(prisma, AUDIT_PURGE_BATCH);
+    if (n === null) {
+      const legacy = await deleteInBatches((tx) => tx.auditLog as unknown as BatchDeletable, auditLogRetentionWhere(now), elapsed);
+      return { ...legacy, details: { via: "direct-delete (audit_log_purge absent)" } };
+    }
+    deleted += n;
+    if (n < AUDIT_PURGE_BATCH) return { deleted, details: { via: "audit_log_purge" } };
+  }
+}
+
 // ─── Generic chunked delete ──────────────────────────────────────────────────
 
 /**
