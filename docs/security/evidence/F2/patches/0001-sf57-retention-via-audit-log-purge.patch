--- a/lib/audit-log.ts
+++ b/lib/audit-log.ts
@@ -335,3 +335,25 @@ export function auditLogRetentionWhere(now: Date): Prisma.AuditLogWhereInput {
     ],
   };
 }
+
+/** Rows per audit_log_purge() call; the database function refuses a batch outside 1..5000. */
+export const AUDIT_PURGE_BATCH = 1000;
+
+/**
+ * SF-57 retention switch. Once the append-only migration (docs/security/evidence/F2/
+ * proposed-auditlog-append-only-v2.sql) is applied, the runtime role has no DELETE on AuditLog and
+ * audit_log_purge(batch) — SECURITY DEFINER, owned by the table owner, minimums hard-coded to match
+ * AUDIT_LOG_RETENTION_MS / AUDIT_EVIDENCE_RETENTION_MS above — is the only delete path. Returns the rows
+ * deleted, or null when the function does not exist yet (migration not applied), so the caller keeps the
+ * direct delete for the rollout window instead of failing. Runs as the plain client: the function needs no
+ * tenant context and no RLS bypass flag.
+ */
+export async function purgeAuditLogBatch(
+  db: { $queryRaw: Prisma.TransactionClient["$queryRaw"] },
+  batch: number = AUDIT_PURGE_BATCH,
+): Promise<number | null> {
+  const present = await db.$queryRaw<Array<{ ok: boolean }>>`SELECT to_regprocedure('public.audit_log_purge(integer)') IS NOT NULL AS ok`;
+  if (!present[0]?.ok) return null;
+  const rows = await db.$queryRaw<Array<{ n: number }>>`SELECT audit_log_purge(${batch}::int) AS n`;
+  return Number(rows[0]?.n ?? 0);
+}
