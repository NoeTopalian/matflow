diff --git a/scripts/readiness/db-target.mjs b/scripts/readiness/db-target.mjs
index 19798cc..03cb667 100644
--- a/scripts/readiness/db-target.mjs
+++ b/scripts/readiness/db-target.mjs
@@ -23,6 +23,12 @@ export class TargetRefused extends Error {}
  */
 export function resolveDbTarget(url, { expectHost, allowProduction = false } = {}) {
   if (typeof url !== "string" || url.length === 0) throw new TargetRefused("no connection string");
+  // pg applies PGOPTIONS (and PGHOST/PGHOSTADDR when the URL lacks them) from the environment, so an
+  // `endpoint=<id>` in PGOPTIONS can route a TEST hostname to another Neon endpoint without touching the URL
+  // (lane F2 review of b871619, 9 Oct 2026). Refuse rather than resolve.
+  for (const k of ["PGOPTIONS", "PGHOST", "PGHOSTADDR"]) {
+    if (process.env[k]) throw new TargetRefused(`REFUSED: ${k} is set in the environment`);
+  }
   let u;
   try { u = new URL(url); } catch { throw new TargetRefused("connection string is not a URL"); }
   // Override parameters that make the effective target differ from the URL host are refused, never resolved.
diff --git a/tests/unit/sec-r-db-target-guard.test.ts b/tests/unit/sec-r-db-target-guard.test.ts
index 456efda..d5186e1 100644
--- a/tests/unit/sec-r-db-target-guard.test.ts
+++ b/tests/unit/sec-r-db-target-guard.test.ts
@@ -32,4 +32,16 @@ describe("resolveDbTarget", () => {
     expect(() => resolveDbTarget("", { expectHost: "x" })).toThrow(TargetRefused);
     expect(() => resolveDbTarget("not a url", { expectHost: "x" })).toThrow(TargetRefused);
   });
+
+  it("refuses PGOPTIONS / PGHOST / PGHOSTADDR in the environment (pg would apply them) — lane F2", () => {
+    for (const k of ["PGOPTIONS", "PGHOST", "PGHOSTADDR"]) {
+      process.env[k] = k === "PGOPTIONS" ? `endpoint=${PRODUCTION_ENDPOINT_ID}` : "elsewhere";
+      try {
+        expect(() => resolveDbTarget(url(TEST), { expectHost: "ep-hidden-salad" })).toThrow(new RegExp(k));
+      } finally {
+        delete process.env[k];
+      }
+    }
+    expect(resolveDbTarget(url(TEST), { expectHost: "ep-hidden-salad" })).toBe(TEST);
+  });
 });
