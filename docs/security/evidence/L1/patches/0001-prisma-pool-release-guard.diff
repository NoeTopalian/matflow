+  // Pool options (max, keepAlive, connection deadline): prismaPoolConfig() above.
+  const pool = new pg.Pool({ connectionString: url, ...prismaPoolConfig() });
+  // SF-136: never keep a client that comes back inside a transaction (adapter-pg's discard of a late-started
+  // transaction releases the client without a ROLLBACK). The server's ReadyForQuery status says where it stands.
+  pool.on("connect", (client) => {
+    const conn = (client as unknown as { connection: { on(e: "readyForQuery", f: (m: { status: string }) => void): void } }).connection;
+    conn.on("readyForQuery", (m) => {
+      (client as unknown as { __txStatus?: string }).__txStatus = m.status;
+    });
+  });
+  pool.on("release", (_err, client) => {
+    const status = (client as unknown as { __txStatus?: string }).__txStatus;
+    if (status === "T" || status === "E") {
+      console.error(`[prisma] pooled client released inside a transaction (status=${status}); closing it`);
+      // end() sets _ending synchronously, so pg-pool removes the client instead of idling it. Its own failure is
+      // observed and logged here, where the promise is created (no unhandled rejection, nothing hidden).
+      client.end().catch((e: Error) => console.error(`[prisma] closing that client failed: ${e.message}`));
+    }
+  });
+  const adapter = new PrismaPg(pool);
